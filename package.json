{
  "name": "city-tourist-help-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Sao_Paulo vitest run",
    "e2e": "playwright test",
    "content": "tsx scripts/build-content.ts",
    "content:strict": "tsx scripts/build-content.ts --strict",
    "photos": "tsx scripts/fetch-photos.ts",
    "budget": "tsx scripts/check-budget.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
