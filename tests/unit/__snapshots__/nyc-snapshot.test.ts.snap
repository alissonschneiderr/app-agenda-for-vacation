          "name": "MoMA – Museum of Modern Art",
          "photoUrls": [
            {
              "label": "📷 fotos",
              "url": "https://www.google.com/search?tbm=isch&q=MoMA+Starry+Night+gallery",
            },
          ],
          "pointId": "ny-moma",
        },
        {
          "access": "ingresso com horário marcado (cerca de USD 10–15) — comprem antes",
          "fields": [
            {
              "label": "",
              "text": "Uma escultura de escadas em forma de colmeia, de cobre, com 154 lances e 80 patamares que se entrelaçam, do arquiteto Thomas Heatherwick. Fechou por segurança e reabriu com telas de aço em todos os níveis. A subida leva 30 a 45 minutos; lá dentro, olhem para baixo pelo centro para ver o padrão de espelhos.",
            },
          ],
          "id": "attraction-vessel",
          "kind": "attraction",
          "mapsUrls": [
