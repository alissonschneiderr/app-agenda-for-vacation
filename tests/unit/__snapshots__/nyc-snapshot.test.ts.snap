          ],
          "pointId": "ny-high-line",
        },
        {
          "fields": [
            {
              "label": "",
              "text": "Entrem sem medo: as galerias são abertas ao público e gratuitas (em geral de terça a sábado, 10h às 18h). As gigantes ficam a poucos passos umas das outras: Gagosian (555 W 24th St), Pace (540 W 25th St) e David Zwirner (W 19th St). As exposições mudam a cada mês ou dois.",
            },
          ],
          "id": "attraction-galerias-de-arte-ruas-19-a-25-entre-a-10th-e-a-11th-avenue",
          "kind": "attraction",
          "mapsUrls": [
            {
              "label": "Mapa",
              "url": "https://www.google.com/maps/search/?api=1&query=Gagosian+555+W+24th+St+New+York",
