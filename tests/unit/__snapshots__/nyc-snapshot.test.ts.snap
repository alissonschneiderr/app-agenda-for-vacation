        {
          "fields": [
            {
              "label": "",
              "text": "Um parque de 2018 à beira do rio, onde funcionava a refinaria de açúcar Domino, que em 1882 era a maior do mundo. Guardaram os tanques de xarope, os guindastes e uma passarela elevada de aço. O sol se põe por volta das 16h47 atrás de Manhattan, com a Williamsburg Bridge à esquerda — é o melhor momento do dia.",
            },
          ],
          "id": "attraction-domino-park",
          "kind": "attraction",
          "mapsUrls": [
