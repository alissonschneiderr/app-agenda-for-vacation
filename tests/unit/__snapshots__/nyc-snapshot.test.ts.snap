          "name": "The Halal Guys",
          "photoUrls": [],
          "price": "💵",
          "queue": "Fila à noite; de dia anda rápido.",
        },
        {
          "address": "Broadway com a rua 40",
          "fields": [
            {
              "label": "",
              "text": "fatia rápida. Pizzaria de 1975 (a original é no Village), sempre no topo das listas de fatia clássica de NY. Peçam a fatia plain (queijo) e dobrem ao meio.",
            },
          ],
          "id": "food-joe-s-pizza",
