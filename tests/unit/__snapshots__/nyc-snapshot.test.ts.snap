        {
          "address": "Times Square, rua 45",
          "fields": [
            {
              "label": "",
              "text": "café da tarde com doce. O cheesecake mais famoso de Nova York, nascido no Brooklyn em 1950: denso, cremoso, com base de pão de ló. Peçam o original plain ou o de morango.",
            },
