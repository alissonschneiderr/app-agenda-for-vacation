          ],
          "name": "Galerias de arte (ruas 19 a 25, entre a 10th e a 11th Avenue)",
          "photoUrls": [
            {
              "label": "📷 fotos",
              "url": "https://www.google.com/search?tbm=isch&q=Gagosian+West+24th+Street+gallery+Chelsea",
            },
          ],
        },
        {
          "fields": [
            {
              "label": "",
              "text": "O mercado coberto montado em 1997 dentro da antiga fábrica da Nabisco, onde o biscoito Oreo foi inventado em 1912. Corredores de tijolo, canos aparentes e uma cascata dentro do prédio. Lá dentro funciona, todos os dias, a feira Artists & Fleas, com designers locais e vintage.",
            },
          ],
          "id": "attraction-chelsea-market-75-9th-ave",
          "kind": "attraction",
          "mapsUrls": [
            {
              "label": "Mapa",
              "url": "https://www.google.com/maps/search/?api=1&query=Chelsea+Market+75+9th+Ave+New+York",
