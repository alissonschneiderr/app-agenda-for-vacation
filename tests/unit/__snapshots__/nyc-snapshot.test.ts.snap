        {
          "address": "75 9th Ave",
          "fields": [
            {
              "label": "",
              "text": "almoço ou lanche. O food hall mais famoso da cidade. Os ícones lá dentro: Los Tacos No. 1 (tacos de adobada que viraram referência em NY; 💵; fila rápida), Very Fresh Noodles (macarrão puxado à mão; 💵) e Fat Witch Bakery 🍰 (brownies desde 1998; 💵). Movimentado no almoço; melhor depois das 14h.",
            },
          ],
          "id": "food-chelsea-market",
          "kind": "food",
          "level": "🏆",
