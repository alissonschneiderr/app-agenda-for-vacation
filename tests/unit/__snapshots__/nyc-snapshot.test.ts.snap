            },
          ],
          "name": "Ess-a-Bagel",
          "photoUrls": [],
          "price": "💵",
          "queue": "Fila forte sábado de manhã; melhor depois das 13h.",
        },
        {
          "address": "carrinho original, 6th Ave com a rua 53",
          "fields": [
            {
              "label": "",
              "text": "almoço rápido. Começou como carrinho de cachorro-quente, virou o símbolo da comida de rua halal em NY e hoje tem filiais no mundo inteiro; este é o carrinho original. Peçam chicken & gyro over rice com o molho branco (cuidado com o vermelho, muito picante).",
            },
          ],
          "id": "food-the-halal-guys",
          "kind": "food",
          "level": "🏆",
