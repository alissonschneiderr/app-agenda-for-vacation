        {
          "address": "W 33rd St",
          "fields": [
            {
              "label": "",
              "text": "café coado. Na praça vizinha de Manhattan West, a 5 minutos do Vessel; mesmo programa de filtrados de torrefações internacionais da Black Fox.",
            },
          ],
          "id": "food-black-fox-coffee-manhattan-west",
