          "photoUrls": [],
        },
        {
          "fields": [
            {
              "label": "",
              "text": "O trecho mais preservado do bairro, com marquises de ferro e galpões baixos. No fim da Gansevoort fica o Whitney Museum, de Renzo Piano (2015), com terraços escalonados — vale ver a fachada.",
            },
          ],
          "id": "attraction-ruas-de-paralelepipedo-e-antigos-frigorificos-gansevoort-washington-e-little-west-12th-st",
          "kind": "attraction",
          "mapsUrls": [
            {
